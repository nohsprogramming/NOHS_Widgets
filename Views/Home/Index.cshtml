@using Widgets.Data.Models
@model IEnumerable<Widgets.Data.Models.Widget>

@{
    ViewData["Title"] = "Home Page";
}

<div class="col-8 offset-2 text-center">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <td class="font-weight-bold">Widget ID</td>
                <td class="font-weight-bold">Widget Name</td>
                <td class="font-weight-bold">Widget Qty</td>
                <td class="font-weight-bold">Image</td>
            </tr>
        </thead>
        <tbody>
            @foreach (Widget widget in Model)
            {
                <tr>
                    <td>@widget.WidgetId</td>
                    <td>@widget.WidgetName</td>
                    <td>@widget.Qty</td>
                    <td><img src="@widget.WidgetImage" style="height:100px;width:100px" /></td>
                </tr>
            }
            
        </tbody>
    </table>
    
</div>
